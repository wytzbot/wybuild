# ===================== Vercel / server-side environment =====================
APP_URL=https://wybuild.vercel.app
# Optional server build override; defaults to the current verified stable Flutter release.
FLUTTER_VERSION=3.47.0
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Exact GitHub OAuth callback URL. Recommended for production; must exactly match the GitHub OAuth App setting.
GITHUB_CALLBACK_URL=https://your-wybuild-domain.example/api/auth/github/callback

# Firebase Admin / Firestore / FCM service-account JSON (server-side only).
# This replaces the former Upstash/Vercel-KV dependency.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}
# Backward-compatible alias for FCM-only deployments; prefer FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON.
# FCM_SERVICE_ACCOUNT_JSON={...}

# Pro checkout URLs. Use hosted checkout links; `{USER_ID}` is replaced by the signed-in GitHub user ID.
WYBUILD_PRO_MONTHLY_URL=
WYBUILD_PRO_YEARLY_URL=
# HMAC secret for your payment provider -> WyBuild entitlement webhook.
BILLING_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Optional comma-separated user IDs/logins for manual Pro grants during testing.
# WYBUILD_PRO_USER_IDS=12345678,github-login

# ===================== GitHub repository Actions secrets =====================
# WyBuild can create WYBUILD_NOTIFY_SECRET automatically when the OAuth token can manage Actions secrets.
# Required for release APK/AAB signing:
# ANDROID_KEYSTORE_BASE64=<base64 of persistent upload keystore>
# ANDROID_KEY_ALIAS=<keystore alias>
# ANDROID_KEY_PASSWORD=<key password>
# ANDROID_STORE_PASSWORD=<keystore password>
# Required for a Play-distributed TWA AAB:
# ANDROID_PLAY_APP_SIGNING_SHA256=<64-hex SHA-256 fingerprint from Play Console App signing>
# Auto-created per repository for server callback authentication:
# WYBUILD_NOTIFY_SECRET=<repository-specific random callback secret>

# ===================== Gemini AI build-repair agent =====================
# AI is optional. Builds remain deterministic and do not depend on Gemini.
AI_AGENT_ENABLED=false
GEMINI_API_KEY=
# Stable, low-cost primary model. Escalation is used only when primary analysis fails.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_MODEL=gemini-3.8-flash
AI_AGENT_MAX_TOKENS=8192
AI_AGENT_MAX_RETRIES=1

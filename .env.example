# Vercel / application
APP_URL=https://wybuild.vercel.app
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# GitHub OAuth App
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# WyDev is the sole Flutterwave billing authority.
WYDEV_URL=https://YOUR-WYDEV-DOMAIN
WYDEV_BILLING_URL=https://YOUR-WYDEV-DOMAIN/billing
WYDEV_BILLING_API_URL=https://YOUR-WYDEV-DOMAIN/api/billing
WYDEV_BILLING_SERVICE_TOKEN=server-only-token

# Public frontend URL only; no secret belongs here.
VITE_WYDEV_BILLING_URL=https://YOUR-WYDEV-DOMAIN/billing

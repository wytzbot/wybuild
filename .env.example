# Vercel / application
APP_URL=https://wybuild.vercel.app
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# GitHub OAuth App
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Vercel KV (required for build usage/cache and FCM device tokens)
KV_REST_API_URL=https://your-kv-instance.kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-rest-api-token

# Firebase service account JSON from Firebase Console (server-side ONLY).
# Store the entire service-account JSON as one Vercel environment variable.
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Free beta: WyBuild billing integration is disabled in api/index.js.
